ACLOCAL_AMFLAGS = -I m4

lib_LTLIBRARIES = libtriv-expr.la

libtriv_expr_la_SOURCES = \
	src/expr.internal.h \
	src/expr.strerror.c
libtriv_expr_la_CPPFLAGS = -I$(top_srcdir)/include
# -version-info is libtool's current:revision:age, which is unrelated
# to the package version.  Only trix_* leaves the library.
libtriv_expr_la_LDFLAGS = -version-info 0:0:0 -no-undefined \
	-export-symbols-regex '^trix_'

triv_exprincludedir = $(includedir)/triv
triv_exprinclude_HEADERS = include/triv/expr.h

pkgconfigdir = $(libdir)/pkgconfig
pkgconfig_DATA = triv-expr.pc

# Generated by configure from man/*.3.in (for the version number).
man3_MANS = man/trix_strerror.3

EXTRA_DIST = Changes README bootstrap triv-expr.pc.in \
	man/trix_strerror.3.in
