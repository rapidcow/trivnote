ACLOCAL_AMFLAGS = -I m4

lib_LTLIBRARIES = libtrx.la

libtrx_la_SOURCES = \
	src/trx_internal.h \
	src/trx_error.c
libtrx_la_CPPFLAGS = -I$(top_srcdir)/include
# -version-info is libtool's current:revision:age, which is unrelated
# to the package version.  Only trx_* leaves the library.
libtrx_la_LDFLAGS = -version-info 0:0:0 -no-undefined \
	-export-symbols-regex '^trx_'

trxincludedir = $(includedir)/trivnote
trxinclude_HEADERS = include/trx.h

pkgconfigdir = $(libdir)/pkgconfig
pkgconfig_DATA = trx.pc

# Generated by configure from man/*.3.in (for the version number).
man3_MANS = man/trx_strerror.3

EXTRA_DIST = Changes README bootstrap trx.pc.in \
	man/trx_strerror.3.in
